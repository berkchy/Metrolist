<?xml version="1.0" encoding="utf-8"?>
<!--
    Expanded media notification for Android 11 (API 30) and below.

    API 31+ draws the redesigned media notification (square artwork on the right,
    transport buttons on the left, elapsed/total time around the scrubber) itself.
    Older platforms only render the legacy template, so the same layout is drawn
    here with RemoteViews.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/media_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/notification_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/media_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/notification_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/media_artwork"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/album_art"
            android:scaleType="centerCrop"
            android:src="@drawable/notification_artwork_placeholder" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/media_previous"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/previous"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/skip_previous"
            android:tint="@color/notification_text_primary" />

        <ImageButton
            android:id="@+id/media_play_pause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/play_pause"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/play"
            android:tint="@color/notification_text_primary" />

        <ImageButton
            android:id="@+id/media_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/next"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/skip_next"
            android:tint="@color/notification_text_primary" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/media_shuffle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/shuffle"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/shuffle"
            android:tint="@color/notification_text_secondary" />

        <ImageButton
            android:id="@+id/media_like"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/like"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_heart_outline"
            android:tint="@color/notification_text_secondary" />

        <ImageButton
            android:id="@+id/media_repeat"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/repeat_mode_all"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/repeat"
            android:tint="@color/notification_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/media_elapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/notification_text_secondary"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/media_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:max="1000"
            android:progressBackgroundTint="@color/notification_progress_track"
            android:progressTint="@color/notification_accent" />

        <TextView
            android:id="@+id/media_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/notification_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
